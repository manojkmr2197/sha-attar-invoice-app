<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!--Product view-->
        <LinearLayout
            android:id="@+id/billing_product_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/interactive_row_background">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/billing_product_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_baseline_clear_24"
                app:backgroundTint="#FF5252"
                app:tint="@color/white"
                app:fabSize="mini"
                app:elevation="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/billing_product_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Attar Name"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/billing_product_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A15"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/code_badge_background"
                        android:padding="4dp"
                        android:visibility="gone" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/billing_product_units"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5 ML"
                        android:textSize="12sp"
                        android:textColor="@color/app_color"
                        android:background="@drawable/quantity_info_background" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/billing_product_total_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹50"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_color"
                        android:background="@drawable/price_display_gradient"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"/>

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/billing_product_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:src="@drawable/ic_baseline_edit_24"
                app:backgroundTint="@color/app_color"
                app:tint="@color/white"
                app:fabSize="mini"
                app:elevation="2dp" />

        </LinearLayout>

        <!--Accessories view-->
        <LinearLayout
            android:id="@+id/billing_accessories_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:background="@drawable/interactive_row_background">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/billing_accessories_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:src="@drawable/ic_baseline_clear_24"
                app:backgroundTint="#FF5252"
                app:tint="@color/white"
                app:fabSize="mini"
                app:elevation="2dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/billing_accessories_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="50 ML fancy bottle"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accessory"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:background="@drawable/type_badge_background"
                        android:padding="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/billing_accessories_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹400"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/app_color"
                        android:background="@drawable/price_display_gradient"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/billing_accessories_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_edit_24"
                app:backgroundTint="@color/app_color"
                app:tint="@color/white"
                app:fabSize="mini"
                app:elevation="2dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>