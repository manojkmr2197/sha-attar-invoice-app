<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Enhanced Header with gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dialog_header_gradient"
            android:gravity="center_vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add New Item"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.9"
                    android:text="Choose product or accessory to add"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/new_bill_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/ic_baseline_close_24"
                android:padding="10sp"
                android:drawableTint="@color/white"
                android:gravity="center" />

        </LinearLayout>

        <!-- Content with enhanced styling -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="3dp">

            <RadioGroup
                android:id="@+id/new_bill_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/new_bill_product"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/radio_option_background"
                    android:button="@null"
                    android:gravity="center"
                    android:text="ATTAR / SPRAY"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/new_bill_non_product"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/radio_option_background"
                    android:button="@null"
                    android:gravity="center"
                    android:text="ACCESSORIES"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </RadioGroup>

            <!-- Product Section -->
            <LinearLayout
                android:id="@+id/new_bill_product_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Product Name Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_container_background"
                    android:orientation="vertical"
                    android:padding="3dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Name"
                        android:textColor="@color/app_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp" />

                    <AutoCompleteTextView
                        android:id="@+id/new_bill_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/enhanced_input_background"
                        android:drawableEnd="@drawable/baseline_arrow_drop_down_24"
                        android:hint="Search Product Name"
                        android:paddingHorizontal="3dp"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Product Details -->
                <LinearLayout
                    android:id="@+id/new_bill_detail_ll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Owner Info Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        app:cardCornerRadius="2dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F8F9FA">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_baseline_person_24"
                                android:drawablePadding="8dp"
                                android:drawableTint="@color/app_color"
                                android:text=""
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/new_bill_item_owner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/app_color"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Product Category Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Product Category"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/new_bill_product_split_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:layout_marginBottom="3dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/new_bill_product_attar"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/category_option_background"
                            android:button="@null"
                            android:gravity="center"
                            android:text="ATTAR"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/new_bill_product_spray"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/category_option_background"
                            android:button="@null"
                            android:gravity="center"
                            android:text="SPRAY"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </RadioGroup>

                    <!-- Quantity Selection -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/input_container_background"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="5dp"
                        android:padding="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/baseline_straighten_24"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/app_color"
                            android:text="Quantity: "
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/new_bill_item_size"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:padding="3dp"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/spinner_enhanced_background" />

                    </LinearLayout>

                    <!-- Selling Price Display -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/price_display_gradient"
                            android:gravity="center_vertical"
                            android:padding="3dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/baseline_currency_rupee_24"
                                android:drawablePadding="8dp"
                                android:drawableTint="@color/app_color"
                                android:text="Selling Price"
                                android:textColor="@color/app_color"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/new_bill_item_selling_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="@color/app_color"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

            <!-- Accessories Section -->
            <LinearLayout
                android:id="@+id/new_bill_non_product_ll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Accessory Name Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input_container_background"
                    android:layout_marginBottom="5dp"
                    android:orientation="vertical"
                    android:padding="3dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accessory Name"
                        android:textColor="@color/app_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp" />

                    <AutoCompleteTextView
                        android:id="@+id/new_bill_non_product_name"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/enhanced_input_background"
                        android:drawableEnd="@drawable/baseline_arrow_drop_down_24"
                        android:hint="Search Accessories Name"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Accessory Price Display -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/price_display_gradient"
                        android:gravity="center_vertical"
                        android:padding="5dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/baseline_currency_rupee_24"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/app_color"
                            android:text="Selling Price"
                            android:textColor="@color/app_color"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/new_bill_non_product_selling_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/app_color"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Occurrence Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_container_background"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pieces"
                    android:textColor="@color/app_color"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/new_bill_occurance"
                    android:layout_width="120dp"
                    android:layout_height="30dp"
                    android:background="@drawable/enhanced_input_background"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:text="1"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Enhanced Submit Button -->
            <TextView
                android:id="@+id/new_bill_add_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/submit_button_enhanced_background"
                android:drawableStart="@drawable/ic_baseline_add_24"
                android:drawablePadding="12dp"
                android:drawableTint="@color/white"
                android:elevation="4dp"
                android:gravity="center"
                android:text="Add Item to Invoice"
                android:padding="5dp"
                android:layout_margin="5dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>