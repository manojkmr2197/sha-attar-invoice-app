<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="3dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header with gradient background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/item_header_gradient"
            android:gravity="center_vertical">

            <!-- Item type badge -->
            <TextView
                android:id="@+id/invoice_history_detail_item_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/type_badge_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PRODUCT"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Left content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <!-- Action buttons with ripple effect -->
                <Button
                    android:id="@+id/invoice_history_detail_item_edit"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/ic_baseline_edit_24"
                    android:drawableTint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/invoice_history_detail_item_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:text="Product Name"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Product code badge -->
                        <TextView
                            android:id="@+id/invoice_history_detail_item_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/code_badge_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text=""
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="2dp">

                        <!-- Quantity with icon -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/quantity_info_background"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/quantity_dot" />

                            <TextView
                                android:id="@+id/invoice_history_detail_item_quantity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="6 ML"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/invoice_history_detail_item_pieces"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 * Rs.100"
                            android:textColor="#666666"
                            android:layout_marginEnd="5dp"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/invoice_history_detail_item_selling_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/price_badge_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="5dp"
                            android:text="Rs.1000"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>


            <Button
                android:id="@+id/invoice_history_detail_item_delete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/baseline_delete_24" />

        </LinearLayout>

        <!-- Bottom accent line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@drawable/item_accent_gradient" />

    </LinearLayout>

</androidx.cardview.widget.CardView>