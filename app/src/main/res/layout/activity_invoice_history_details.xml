<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.InvoiceHistoryDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/invoice_history_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_margin="5dp"
            android:background="@drawable/ic_baseline_arrow_back_24" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center"
            android:layout_marginEnd="50dp">

            <TextView
                android:id="@+id/invoice_history_detail_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Invoice"
                android:textColor="@color/app_color"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/invoice_history_detail_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center"
            android:layout_margin="8dp"
            android:drawableStart="@drawable/baseline_access_time_24"
            android:gravity="center"
            android:text="Select Date"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3sp"
        android:alpha="0.5"
        android:background="@color/black" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="5dp">

        <EditText
            android:id="@+id/invoice_history_detail_customer_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:hint="Enter Customer phone number"
            android:inputType="number"
            android:padding="12dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/invoice_history_detail_customer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@android:drawable/edit_text"
            android:hint="Enter Customer name"
            android:padding="12dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/invoice_history_detail_remarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:hint="Enter Remarks"
            android:padding="12dp"
            android:textSize="13sp" />


        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/invoice_history_detail_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>


    <Button
        android:id="@+id/invoice_history_detail_add_item_bt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center|end"
        android:layout_marginRight="5sp"
        android:text="Add Items"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="2dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="5sp">

                <!--Total product price-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10sp"
                        android:layout_weight="0.7"
                        android:gravity="end"
                        android:text="Total Product Price "
                        android:textAllCaps="true"
                        android:textColor="@color/app_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/invoice_history_detail_total_amount_price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="0.3"
                        android:text="Rs. 0"
                        android:textColor="@color/app_color"
                        android:textStyle="bold" />


                </LinearLayout>

                <!--Discount-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5sp"
                    android:gravity="center">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10sp"
                        android:layout_weight="0.7"
                        android:gravity="end"
                        android:text="Discount "
                        android:textAllCaps="true"
                        android:textColor="@color/app_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/invoice_history_detail_discount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="0.3"
                        android:text="0 %"
                        android:textColor="@color/app_color"
                        android:textStyle="bold" />

                </LinearLayout>

                <!--Total selling price-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10sp"
                    android:gravity="center">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10sp"
                        android:layout_weight="0.7"
                        android:gravity="end"
                        android:text="Total Billing Price "
                        android:textAllCaps="true"
                        android:textColor="@color/app_color"
                        android:textSize="13sp" />


                    <TextView
                        android:id="@+id/invoice_history_detail_total_selling_price"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="0.3"
                        android:text="Rs. 0"
                        android:textColor="@color/app_color"
                        android:textStyle="bold" />


                </LinearLayout>

                <Button
                    android:id="@+id/invoice_history_detail_submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:text="Add Invoice"
                    android:textSize="12sp" />
            </LinearLayout>


        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>