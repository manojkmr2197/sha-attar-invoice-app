<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.InvoiceHistoryDetailsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/invoice_history_detail_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_margin="5dp"
            android:background="@drawable/ic_baseline_arrow_back_24" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center"
            android:layout_marginEnd="50dp">

            <TextView
                android:id="@+id/invoice_history_detail_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Invoice"
                android:textColor="@color/app_color"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/invoice_history_detail_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center"
            android:layout_margin="8dp"
            android:drawableStart="@drawable/baseline_access_time_24"
            android:gravity="center"
            android:text="Select Date"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3sp"
        android:alpha="0.5"
        android:background="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end">

                <TextView
                    android:id="@+id/invoice_history_detail_customer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="Mano"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/invoice_history_detail_customer_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginStart="10sp"
                    android:text="9585905176"
                    android:textSize="13sp" />


            </LinearLayout>

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/invoice_history_detail_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

        <Button
            android:id="@+id/invoice_history_detail_add_item_bt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|end"
            android:layout_marginRight="5sp"
            android:text="Add Items"
            android:textSize="10sp" />


    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="2dp">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5sp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <CheckBox
                            android:id="@+id/invoice_history_detail_is_courier_checkBox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Is Courier Bill ?"
                            android:textColor="@color/app_color" />

                        <EditText
                            android:id="@+id/invoice_history_detail_courier_amount"
                            android:layout_width="150sp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10sp"
                            android:hint="Enter Courier Amount*"
                            android:inputType="number"
                            android:textColor="@color/app_color"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!--Total product price-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10sp"
                            android:layout_weight="0.7"
                            android:gravity="end"
                            android:text="Total Product Price "
                            android:textAllCaps="true"
                            android:textColor="@color/app_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/invoice_history_detail_total_amount_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="0.3"
                            android:text="Rs. 0"
                            android:textColor="@color/app_color"
                            android:textStyle="bold" />


                    </LinearLayout>

                    <!--Discount-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5sp"
                        android:gravity="center">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10sp"
                            android:layout_weight="0.7"
                            android:gravity="end"
                            android:text="Discount "
                            android:textAllCaps="true"
                            android:textColor="@color/app_color"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/invoice_history_detail_discount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="0.3"
                            android:text="0 %"
                            android:textColor="@color/app_color"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!--Total selling price-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10sp"
                        android:gravity="center">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10sp"
                            android:layout_weight="0.7"
                            android:gravity="end"
                            android:text="Total Billing Price "
                            android:textAllCaps="true"
                            android:textColor="@color/app_color"
                            android:textSize="13sp" />


                        <TextView
                            android:id="@+id/invoice_history_detail_total_selling_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_weight="0.3"
                            android:text="Rs. 0"
                            android:textColor="@color/app_color"
                            android:textStyle="bold" />


                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="30sp"
                        android:gravity="center"
                        android:text="Payment Details"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/invoice_history_detail_payment_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="3" />

                        <RadioButton
                            android:id="@+id/invoice_history_detail_payment_cash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CASH" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <RadioButton
                            android:id="@+id/invoice_history_detail_payment_upi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UPI" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <RadioButton
                            android:id="@+id/invoice_history_detail_payment_card"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CARD" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                    </RadioGroup>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardChargeCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tvCardCharge"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Card Charges: ₹0.00"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvGST"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="GST (18%): ₹0.00"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvTotalExtra"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Total Extra: ₹0.00"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvFinalPayable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        app:cardBackgroundColor="@color/app_gray"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Final Payable Amount"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvFinalPayableAmount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="₹0.00"
                                android:textColor="@color/black"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvChargeInfo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Includes all charges and taxes"
                                android:textColor="@color/black"
                                android:textSize="12sp" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <Button
                        android:id="@+id/invoice_history_detail_submit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|bottom"
                        android:text="Add Invoice"
                        android:textSize="12sp" />
                </LinearLayout>


            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>