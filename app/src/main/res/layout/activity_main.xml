<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".activity.MainActivity">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/home_nav_text_view"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/ic_baseline_menu_open_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sha's Attar Invoice"
                        android:textColor="@color/app_color"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/home_invoice_history"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:layout_margin="5dp"
                    android:background="@drawable/baseline_list_alt_24" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <!--Billing recycler view-->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/home_recyclerView"
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:nestedScrollingEnabled="false"
                                    android:overScrollMode="always" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/new_billing_all_clear"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_gravity="center_vertical"
                                        android:layout_margin="5dp"
                                        android:backgroundTint="@color/black"
                                        android:background="@drawable/ic_baseline_close_24" />

                                    <Button
                                        android:id="@+id/home_bill_add_bt"
                                        android:layout_width="300dp"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:text="Add Bill" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/home_content_ll"
                                    android:layout_width="match_parent"
                                    android:layout_height="400dp"
                                    android:layout_gravity="bottom"
                                    android:orientation="vertical">

                                    <ScrollView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content">

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="match_parent"
                                                android:layout_height="30sp"
                                                android:gravity="center"
                                                android:text="Billing Details"
                                                android:textSize="18sp"
                                                android:textStyle="bold" />

                                            <androidx.cardview.widget.CardView
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_margin="5sp"
                                                app:cardCornerRadius="5sp">

                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:orientation="vertical"
                                                    android:padding="5sp">

                                                    <!--Total product price-->
                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:gravity="center">

                                                        <TextView
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginEnd="10sp"
                                                            android:layout_weight="0.7"
                                                            android:gravity="end"
                                                            android:text="Total Product Price "
                                                            android:textAllCaps="true"
                                                            android:textColor="@color/app_color"
                                                            android:textSize="13sp" />

                                                        <TextView
                                                            android:id="@+id/billing_total_amount_price"
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginStart="5dp"
                                                            android:layout_weight="0.3"
                                                            android:text="Rs. 40"
                                                            android:textColor="@color/app_color"
                                                            android:textStyle="bold" />


                                                    </LinearLayout>

                                                    <!--Discount-->
                                                    <LinearLayout
                                                        android:id="@+id/billing_discount_ll"
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:layout_marginTop="5sp"
                                                        android:gravity="center">


                                                        <TextView
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginEnd="10sp"
                                                            android:layout_weight="0.7"
                                                            android:gravity="end"
                                                            android:text="Discount "
                                                            android:textAllCaps="true"
                                                            android:textColor="@color/app_color"
                                                            android:textSize="13sp" />

                                                        <TextView
                                                            android:id="@+id/billing_discount"
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginStart="5dp"
                                                            android:layout_weight="0.3"
                                                            android:text="5 %"
                                                            android:textColor="@color/app_color"
                                                            android:textStyle="bold" />

                                                    </LinearLayout>

                                                    <!--Total selling price-->
                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:layout_marginTop="10sp"
                                                        android:gravity="center">


                                                        <TextView
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginEnd="10sp"
                                                            android:layout_weight="0.7"
                                                            android:gravity="end"
                                                            android:text="Total Billing Price "
                                                            android:textAllCaps="true"
                                                            android:textColor="@color/app_color"
                                                            android:textSize="13sp" />


                                                        <TextView
                                                            android:id="@+id/billing_total_selling_price"
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginStart="5dp"
                                                            android:layout_weight="0.3"
                                                            android:text="Rs. 40"
                                                            android:textColor="@color/app_color"
                                                            android:textStyle="bold" />


                                                    </LinearLayout>

                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content">

                                                        <CheckBox
                                                            android:id="@+id/new_billing_is_courier_checkBox"
                                                            android:layout_width="wrap_content"
                                                            android:layout_height="wrap_content"
                                                            android:text="Is Courier Bill ?"
                                                            android:textColor="@color/app_color" />

                                                        <EditText
                                                            android:id="@+id/new_billing_courier_amount"
                                                            android:layout_width="match_parent"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginStart="10sp"
                                                            android:hint="Enter Courier Amount*"
                                                            android:inputType="number"
                                                            android:textColor="@color/black"
                                                            android:textSize="13sp"
                                                            android:visibility="gone" />
                                                    </LinearLayout>

                                                </LinearLayout>


                                            </androidx.cardview.widget.CardView>

                                            <TextView
                                                android:layout_width="match_parent"
                                                android:layout_height="30sp"
                                                android:gravity="center"
                                                android:text="Biller Information"
                                                android:textSize="18sp"
                                                android:textStyle="bold" />

                                            <androidx.cardview.widget.CardView
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:layout_margin="5sp"
                                                app:cardCornerRadius="5sp">

                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:orientation="vertical"
                                                    android:padding="5sp">

                                                    <!--customer Phone-->
                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:gravity="center">

                                                        <TextView
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginEnd="10sp"
                                                            android:layout_weight="0.3"
                                                            android:gravity="end"
                                                            android:text="Phone No *"
                                                            android:textAllCaps="true"
                                                            android:textColor="@color/app_color"
                                                            android:textSize="13sp" />

                                                        <TextView
                                                            android:id="@+id/billing_customer_phone"
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginStart="5dp"
                                                            android:layout_weight="0.7"
                                                            android:text="9876543210"
                                                            android:textColor="@color/black"
                                                            android:textSize="13sp" />

                                                    </LinearLayout>

                                                    <!--customer Name-->
                                                    <LinearLayout
                                                        android:layout_width="match_parent"
                                                        android:layout_height="wrap_content"
                                                        android:layout_marginTop="3sp"
                                                        android:gravity="center">

                                                        <TextView
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginEnd="10sp"
                                                            android:layout_weight="0.3"
                                                            android:gravity="end"
                                                            android:text="Name *"
                                                            android:textAllCaps="true"
                                                            android:textColor="@color/app_color"
                                                            android:textSize="13sp" />

                                                        <TextView
                                                            android:id="@+id/billing_customer_name"
                                                            android:layout_width="0dp"
                                                            android:layout_height="wrap_content"
                                                            android:layout_marginStart="5dp"
                                                            android:layout_weight="0.7"
                                                            android:text="Mano"
                                                            android:textColor="@color/black"
                                                            android:textSize="13sp" />

                                                    </LinearLayout>

                                                    <TextView
                                                        android:layout_width="match_parent"
                                                        android:layout_height="30sp"
                                                        android:gravity="center"
                                                        android:text="Payment Details"
                                                        android:textSize="18sp"
                                                        android:textStyle="bold" />

                                                    <RadioGroup
                                                        android:id="@+id/new_bill_payment_radio_group"
                                                        android:layout_width="match_parent"
                                                        android:layout_height="match_parent"
                                                        android:orientation="horizontal">

                                                        <View
                                                            android:layout_width="0dp"
                                                            android:layout_height="match_parent"
                                                            android:layout_weight="1" />

                                                        <RadioButton
                                                            android:id="@+id/new_billing_payment_cash"
                                                            android:layout_width="wrap_content"
                                                            android:layout_height="wrap_content"
                                                            android:text="CASH" />

                                                        <View
                                                            android:layout_width="0dp"
                                                            android:layout_height="match_parent"
                                                            android:layout_weight="1" />

                                                        <RadioButton
                                                            android:id="@+id/new_billing_payment_upi"
                                                            android:layout_width="wrap_content"
                                                            android:layout_height="wrap_content"
                                                            android:text="UPI" />

                                                        <View
                                                            android:layout_width="0dp"
                                                            android:layout_height="match_parent"
                                                            android:layout_weight="1" />

                                                    </RadioGroup>

                                                </LinearLayout>


                                            </androidx.cardview.widget.CardView>

                                            <Button
                                                android:id="@+id/billing_submit_invoice"
                                                android:layout_width="200sp"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:gravity="center"
                                                android:text="Submit Invoice" />


                                        </LinearLayout>

                                    </ScrollView>

                                </LinearLayout>
                            </LinearLayout>

                        </FrameLayout>

                        <!--Empty data-->
                        <FrameLayout
                            android:id="@+id/home_empty_ll"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="No Bill Data found"
                                android:textColor="@color/app_color"
                                android:textSize="20sp" />

                        </FrameLayout>

                    </LinearLayout>

                </LinearLayout>


            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </FrameLayout>


    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_main"
        app:menu="@menu/menu_main" />
</androidx.drawerlayout.widget.DrawerLayout>