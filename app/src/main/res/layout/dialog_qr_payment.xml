<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/header_gradient_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/baseline_qr_code_scanner_24"
                app:tint="@color/app_color"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UPI Payment"
                android:textColor="@color/app_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/main_bill_qr_image_close"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_baseline_close_24"
                app:tint="@color/app_color"
                android:background="@drawable/close_button_background"
                android:padding="6dp" />

        </LinearLayout>

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <!-- QR Code Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="220dp"
                android:layout_height="220dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/main_bill_qr_image"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Instructions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan QR code with any UPI app"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/app_color"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="or use the button below to pay directly"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:alpha="0.7"
                android:layout_marginBottom="16dp" />

            <!-- Payee Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/app_gray"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/main_bill_qr_payee_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Payee: Sha's Attar Shop"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:padding="12dp"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayWithUPI"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Pay with UPI"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/app_gray"
                    app:cornerRadius="24dp"
                    android:textColor="@color/app_color"
                    app:strokeColor="@color/app_color"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/main_bill_qr_image_submit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Payment Complete"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/app_color"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/baseline_receipt_24"
                    app:iconGravity="textStart" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>