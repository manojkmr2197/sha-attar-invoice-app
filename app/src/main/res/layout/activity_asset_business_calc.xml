                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/asset_biz_result_total_amt_tv"
                android:text=""
                android:layout_gravity="center"
                android:textColor="@color/black"
                android:textSize="18sp" />

