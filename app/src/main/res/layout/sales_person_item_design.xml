<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.5"
        android:background="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <Button
            android:id="@+id/sales_person_item_delete"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_gravity="center"
            android:background="@drawable/ic_baseline_clear_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:layout_marginStart="10sp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/sales_person_item_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:layout_marginBottom="3sp"
                android:textAllCaps="true"
                android:textColor="@color/app_color"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/sales_person_item_phoneNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="10sp" />
        </LinearLayout>


        <TextView
            android:id="@+id/sales_person_item_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.075"
            android:text=""
            android:textAllCaps="true"
            android:textColor="@color/app_color"
            android:textSize="10sp" />


        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1sp"
            android:layout_marginEnd="1sp"
            android:alpha="0.5"
            android:background="@color/black" />


        <TextView
            android:id="@+id/sales_person_item_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.1"
            android:background="#9FE2BF"
            android:gravity="center"
            android:text=""
            android:textAllCaps="true"
            android:layout_margin="3sp"
            android:textColor="@color/black"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/sales_person_item_edit"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_gravity="center"
            android:background="@drawable/ic_baseline_edit_24" />

    </LinearLayout>
</LinearLayout>